[Unit]
Description=RT-JPN-OCR server (FastAPI + OCR + WS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/rt-jpn-ocr
EnvironmentFile=/home/pi/rt-jpn-ocr/.env
ExecStart=/home/pi/rt-jpn-ocr/.venv/bin/python -m uvicorn server:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
